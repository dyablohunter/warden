# ─────────────────────────────────────────────────────────────────────────────
# Warden configuration. Copy to .env (dev) or /etc/warden/warden.env (installed).
# Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ────────────────────────────────────────────────────────────
# deepseek | openai | anthropic | openrouter | groq | mistral | gemini | ollama | custom
LLM_PROVIDER=deepseek
# Key: LLM_API_KEY, or <PROVIDER>_API_KEY (e.g. DEEPSEEK_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY)
DEEPSEEK_API_KEY="sk-..."
# LLM_API_KEY=
# Model / endpoint overrides (defaults exist for deepseek and anthropic; required for others)
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=180

# Optional fallback provider, used when the primary errors out
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=claude-sonnet-5-5
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=

# ── Agent behaviour ─────────────────────────────────────────────────────────
# observe = read-only | contain = + bans, routines, triggers | full = + changes to the system
WARDEN_AUTONOMY=full
# Step cap for operator `ask` runs; routines/triage use 15, incident follow-ups 20 (never above this)
AGENT_MAX_STEPS=30
# Input-token cap per agent run (the agent is told to wrap up at 70%)
AGENT_MAX_TOKENS_PER_RUN=250000
# Rolling 24h budget in "effective" tokens (fresh input + output + 10% of cached input).
# When exceeded, scheduled routines pause; attacks, triggers and incidents keep being
# handled. A quiet server typically uses well under 200k/day. 0 = unlimited.
WARDEN_DAILY_TOKEN_BUDGET=2000000
# Allow the agent to reboot / power off the host (denied by default)
WARDEN_ALLOW_REBOOT=false
# Apply network-hardening sysctls (syncookies, no redirects, ...) on start
WARDEN_HARDEN_SYSCTL=true
# Follow-ups back off 30m, 1h, 2h ... 24h; after this many the incident is handed to you
INCIDENT_MAX_CHECKS=12

# ── Protection ──────────────────────────────────────────────────────────────
# IPs / CIDRs that must NEVER be banned (your home/office IP, monitoring, bastion...)
WARDEN_ALLOWLIST=
# IPs with a successful SSH login in the last N days are never auto-banned
TRUSTED_LOGIN_DAYS=14

# ── Sentinel (fast, deterministic attack response) ──────────────────────────
# Logs are streamed (journald) / tailed in real time; /proc counters are sampled every tick.
SENTINEL_ENABLED=true
SENTINEL_INTERVAL=10
BAN_BASE_MINUTES=60
BAN_MAX_MINUTES=43200
# Auth failures (SSH, PostgreSQL, MySQL, SMTP, IMAP) per IP within the window -> ban
SSH_MAX_FAILURES=8
SSH_WINDOW_SECONDS=600
CONN_PER_IP_MAX=150
# Web: per-IP requests/min, 4xx/min, failed logins (401/403 on auth paths) per 10 min, exploit probes
HTTP_MAX_REQ_PER_MIN=600
HTTP_MAX_4XX_PER_MIN=120
HTTP_AUTH_FAIL_MAX=20
HTTP_EXPLOIT_HITS=3
# Never auto-ban private IPs seen in web logs (they're usually your reverse proxy / load balancer)
WEB_BAN_PRIVATE=false
# Bans within 10 minutes that count as a coordinated attack wave (wakes the agent)
ATTACK_WAVE_BANS=20
# Space-separated globs of access logs (combined format or JSON, e.g. Caddy)
WEB_ACCESS_LOGS="/var/log/nginx/access.log /var/log/apache2/access.log /var/log/caddy/access.log"

# nftables per-source limits (0 disables the rule). The agent can tighten syn/conn live during an attack.
NFT_SYN_RATE_PER_SEC=100
NFT_CONN_LIMIT=500
NFT_ICMP_RATE_PER_SEC=20

# ── Reverse proxy / CDN (Cloudflare) ────────────────────────────────────────
# Addresses that are never banned and skip per-source flood limits (thousands of visitors share
# them). "cloudflare" = Cloudflare's published ranges, refreshed weekly. Add your own LB CIDRs too.
TRUSTED_PROXIES=cloudflare
# Optional: block attackers at the Cloudflare edge. Host firewalls can't stop traffic that arrives
# through Cloudflare. Token needs IP Access Rules edit permission (Account › Account Firewall Access
# Rules › Edit, or Zone › Firewall Services › Edit). Set ACCOUNT_ID (all zones) or ZONE_ID.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# ── Data retention ──────────────────────────────────────────────────────────
# Everything Warden stores is rotated hourly and capped (events 30d / info 7d, emails 30d, unseen
# error signatures 30d, resolved incidents 180d, hard row caps). This sets the audit trail (actions,
# LLM runs) retention. Config backups: 30 days and at most WARDEN_BACKUP_MAX_MB.
WARDEN_RETENTION_DAYS=90
WARDEN_BACKUP_MAX_MB=200

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_TO=you@example.com
EMAIL_FROM=warden@your-server.example.com
SMTP_HOST=smtp.example.com
# 587 = STARTTLS, 465 = implicit TLS, 25 = plain
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# info | low | medium | high | critical — minimum severity that gets emailed
EMAIL_MIN_SEVERITY=medium
EMAIL_MAX_PER_HOUR=6
EMAIL_ON_START=true

# ── Paths ───────────────────────────────────────────────────────────────────
# WARDEN_STATE_DIR=/var/lib/warden
